# Local foundation setup. Copy only if .env does not already exist.
# Replace all replace_* values; never commit your real .env.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=digital_banking_db
DB_USER=postgres
DB_PASSWORD=replace_database_password

# Base64-encoded random signing key, at least 32 bytes before encoding.
JWT_SECRET=replace_base64_signing_secret
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# Server & Profile
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=local
DEV_SEED_ENABLED=true
DEV_SEED_PASSWORD=replace_demo_password_at_least_12_characters
JPA_SHOW_SQL=false
JPA_FORMAT_SQL=false

# Gmail delivery to real recipient inboxes. Use a sender account's app password.
# https://support.google.com/accounts/answer/185833
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=replace_sender@gmail.com
MAIL_PASSWORD=replace_gmail_app_password
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true

# OTP email transport: smtp (default, uses MAIL_* above) or gmail-api (HTTPS on port 443).
# Use gmail-api on hosts that block outbound SMTP ports (Railway Trial/Hobby, Render free).
MAIL_PROVIDER=smtp
# Gmail API: OAuth client (Web application) + refresh token with scope https://www.googleapis.com/auth/gmail.send,
# issued for the sending account. In "Testing" consent mode the refresh token expires after about 7 days.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Optional From address; must be the authorized account or its alias. Blank = the account's address.
GMAIL_SENDER=

# Native QR Configuration
APP_QR_MERCHANT_NAME=Digital Bank
APP_QR_MERCHANT_CITY=Phnom Penh
APP_QR_ACQUIRING_BANK=Digital Bank
APP_QR_COUNTRY_CODE=KH
APP_QR_GUID=bank@digitalbank

## Optional separate staff identity for local Gmail QA (never enabled in prod).
## Set all four only when deliberately provisioning a new local QA staff user.
# QA_STAFF_ENABLED=false
# QA_STAFF_USERNAME=f3.qa.staff
# QA_STAFF_EMAIL=your-controlled-inbox+staff@gmail.com
# QA_STAFF_PASSWORD=choose-a-separate-local-qa-password

# Telegram OIDC: server-side only; callback must exactly match BotFather.
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=
TELEGRAM_REDIRECT_URI=
TELEGRAM_FRONTEND_ORIGIN=http://localhost:8081
# Registered Android App Link, including the /tglogin path. No secret belongs in Flutter.
TELEGRAM_NATIVE_REDIRECT_URI=

# Opt-in USD 200 / KHR 100000 credits for newly opened pairs in non-production only.
TEST_OPENING_FUNDING_ENABLED=false

# Core assistant: disabled until provider billing and customer-data handling are reviewed.
# Replaces GEMINI_*: those names are no longer read (startup logs a warning if they remain); a Gemini key does not work here.
# Groq (OpenAI-compatible). Free key: https://console.groq.com/keys . AI_MODEL must match an id from GET {AI_API_URL}/models.
AI_API_URL=https://api.groq.com/openai/v1
AI_API_KEY=
AI_MODEL=qwen/qwen3.8-27b
# schema = strict json_schema (Groq qwen/gpt-oss models); object = json_object; prompt = instructions only.
AI_JSON_MODE=schema
# qwen: none|default|low|medium|high (none = fastest). gpt-oss: low|medium|high. Blank = not sent.
AI_REASONING_EFFORT=none
AI_ENABLED=false
AI_CUSTOMER_CONTEXT_ENABLED=false
