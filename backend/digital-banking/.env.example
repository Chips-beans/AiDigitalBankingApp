# Copy to .env; .env is ignored by git. Replace placeholders before running.
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080
DB_HOST=localhost
DB_PORT=5432
DB_NAME=digital_banking_db
DB_USER=postgres
DB_PASSWORD=replace_with_local_database_password
# Generate using the command in docs/PHASE_0_IMPLEMENTATION.md; at least 32 random bytes, Base64 encoded.
JWT_SECRET=replace_with_generated_base64_secret
DEV_SEED_ENABLED=true
DEV_SEED_PASSWORD=replace_with_local_demo_password
# Local SMTP capture server; authentication/TLS are disabled only in local profile.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=wallet@example.test
CORS_ALLOWED_ORIGINS=http://localhost:8081
