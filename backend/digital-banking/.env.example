# Database Credentials
DB_HOST=localhost
DB_PORT=5432
DB_NAME=digital_banking_db
DB_USER=USERNAME
DB_PASSWORD=PASSWORD

# JWT Security Credentials (Minimum 256-bit secret)
JWT_SECRET=TOKEN
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# Server & Profile
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
JPA_SHOW_SQL=true
JPA_FORMAT_SQL=true

#Gmail OTP
MAIL_USERNAME=EMAIL
MAIL_PASSWORD=PASSWORD

#Bakong OpenAPI 
BAKONG_API_URL=https://api-bakong.nbc.gov.kh
BAKONG_API_TOKEN=your_real_sandbox_token_here
BAKONG_MERCHANT_NAME=Digital Bank
BAKONG_MERCHANT_CITY=Phnom Penh