# Local foundation setup. Copy only if .env does not already exist.
# Replace the three replace_* values; never commit your real .env.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=digital_banking_db
DB_USER=postgres
DB_PASSWORD=replace_database_password

# Base64-encoded random signing key, at least 32 bytes before encoding.
JWT_SECRET=replace_base64_signing_secret
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# Server & Profile
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=local
DEV_SEED_ENABLED=true
DEV_SEED_PASSWORD=replace_demo_password_at_least_12_characters
JPA_SHOW_SQL=false
JPA_FORMAT_SQL=false

# Local Mailpit: SMTP capture only; no real email account or password required.
# Start with: .\scripts\start-local-mail.ps1
# Read OTPs at http://127.0.0.1:8025
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=wallet@example.test
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false

# Deferred integrations; not needed for the foundation.
BAKONG_API_URL=https://api-bakong.nbc.gov.kh
BAKONG_API_TOKEN=
BAKONG_MERCHANT_NAME=Digital Bank
BAKONG_MERCHANT_CITY=Phnom Penh
